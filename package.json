{
  "name": "real-role-auth-mockserver-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:app": "node app/server.mjs",
    "start:mockserver": "node mockserver/src/mock-server.js",
    "test:e2e": "playwright test --config=playwright/playwright.config.ts",
    "test:roles": "playwright test --config=playwright/playwright.config.ts --grep @roles",
    "test:legacy-interception": "playwright test --config=playwright/playwright.config.ts --grep @legacy-interception",
    "test:headed": "playwright test --config=playwright/playwright.config.ts --headed",
    "show-report": "playwright show-report playwright-report",
    "benchmark": "python3 benchmarks/dashboard/run.py",
    "benchmark:summary": "node benchmarks/summarize.mjs",
    "benchmark:test": "node --test benchmarks/*.test.mjs",
    "benchmark:publish": "python3 benchmarks/dashboard/publish.py",
    "security:staged": "node scripts/security-gate.mjs",
    "security:hooks": "node scripts/install-security-hook.mjs",
    "security:check": "python3 scripts/security_audit.py"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.1.2",
    "koa-mount": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
